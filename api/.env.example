ENVIRONMENT=development
DATABASE_URL=sqlite:///./tasks.db
PUBLIC_URL=http://localhost:5173
SECRET_KEY=local-development-only-key-do-not-deploy
DEV_LOGIN=true
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_WEB_CLIENT_ID=
APPLE_NATIVE_CLIENT_IDS=com.example.tasks.ios,com.example.tasks.macos
# Comma-separated Apple subjects or verified email addresses. Empty allows any account, in development only.
ALLOWED_APPLE_ACCOUNTS=

# Optional reminder delivery. Configure stable VAPID keys and/or an APNs signing key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
