ENVIRONMENT=development
DATABASE_URL=sqlite:///./tasks.db
PUBLIC_URL=http://localhost:5173
SECRET_KEY=local-development-only-key-do-not-deploy
DEV_LOGIN=true
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_WEB_CLIENT_ID=
APPLE_NATIVE_CLIENT_IDS=com.example.tasks.ios,com.example.tasks.macos
# Comma-separated Apple subjects or verified email addresses. Empty allows any account, in development only.
ALLOWED_APPLE_ACCOUNTS=

# Optional reminder delivery. Configure stable VAPID keys and/or an APNs signing key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=

# Optional: where Notebook's web app runs, so note links open there and pasted note addresses become references.
NOTEBOOK_WEB_URL=

# Optional in-app agent (Flesh out). Hidden unless ANTHROPIC_API_KEY is set.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
# This server's own address as seen from itself, for the agent's MCP connection.
AGENT_TASKS_URL=http://127.0.0.1:8000
# Other MCP servers the agent may use; each token is read from the named variable.
AGENT_MCP_SERVERS=[]
# AGENT_MCP_SERVERS=[{"name": "notebook", "url": "http://localhost:3333/mcp", "token_env": "NOTEBOOK_TOKEN"}]
# NOTEBOOK_TOKEN=
