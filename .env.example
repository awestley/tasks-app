# Production deployment, never commit your real .env file.
ENVIRONMENT=production
DOMAIN=tasks.example.com
PUBLIC_URL=https://tasks.example.com
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_ALPHANUMERIC_PASSWORD
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
DEV_LOGIN=false
APPLE_TEAM_ID=REPLACE_ME
APPLE_KEY_ID=REPLACE_ME
# Paste .p8 contents as one quoted value using literal \n between lines.
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----"
APPLE_WEB_CLIENT_ID=com.example.taskwell.web
APPLE_NATIVE_CLIENT_IDS=com.example.taskwell.ios,com.example.taskwell.macos

# Optional reminder delivery. Configure stable VAPID keys and/or an APNs signing key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
